{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XPinAT PC",
  "version": "0.1.0",
  "identifier": "com.XPinAT.pc.app",
  "build": {
    "beforeDevCommand": "cd ../ui && bun run dev", 
    "beforeBuildCommand": "cd ../ui && bun run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/build"
  },
  "app": {
    "windows": [
      {
        "title": "fin-app",
        "width": 1100,
        "height": 750,
        "resizable": true,
        "fullscreen": false,
		"maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
