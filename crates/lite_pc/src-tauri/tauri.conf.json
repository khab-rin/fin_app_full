{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xpin_pc",
  "version": "0.1.0",
  "identifier": "com.pxin.pc.app",
  "build": {
	"beforeDevCommand": {
		"script": "bun run dev",
		"cwd": "../ui"
	},
	"beforeBuildCommand": {
		"script": "bun run build",
		"cwd": "../ui"
	},
	"devUrl": "http://127.0.0.1:5173",
	"frontendDist": "../ui/build"
  },
  "app": {
    "windows": [
      {
        "title": "fin-app",
        "width": 1100,
        "height": 750,
        "resizable": true,
        "fullscreen": false,
		"maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
	"publisher": "xpinat",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
