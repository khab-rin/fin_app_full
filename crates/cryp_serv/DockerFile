
FROM rust:slim-bookworm AS builder
WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends pkg-config libssl-dev && \
    rm -rf /var/lib/apt/lists/*

ARG CRATE_NAME

COPY Cargo.toml Cargo.lock ./

RUN sed -i '/members = \[/,/\]/c\members = [ "crates/shared_lib", "crates/'"${CRATE_NAME}"'" ]' Cargo.toml

COPY crates/shared_lib/ ./crates/shared_lib/
COPY crates/${CRATE_NAME}/ ./crates/${CRATE_NAME}/
COPY crates/tauri-plugin-machine-uid/ ./crates/tauri-plugin-machine-uid/

RUN cargo build --release -p ${CRATE_NAME}

RUN ls -la target/release/

RUN cp target/release/cryp_serv_bin /app/cryp_serv


FROM debian:bookworm-slim
WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        libccid \
        pcscd \
        lsb-release \
        procps \
        libusb-1.0-0 && \
    rm -rf /var/lib/apt/lists/*

ADD crates/cryp_serv/linux-amd64_deb.tgz /tmp/

RUN cd /tmp/linux-amd64_deb && \
    (dpkg -i *.deb || echo "Пакеты распакованы, долечиваем зависимости...")

RUN apt-get update && \
    (apt-get install -y -f --no-install-recommends || true) && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/cryp_serv /app/cryp_serv
COPY crates/cryp_serv/russian_trusted_root_ca.cer /app/russian_trusted_root_ca.cer

RUN rm -rf /tmp/linux-amd64_deb

CMD /etc/init.d/cprocsp start && \
    /opt/cprocsp/bin/amd64/certmgr -inst -store mRoot -file /app/russian_trusted_root_ca.cer && \
    ./cryp_serv
